# Copy this file to backend/.env and paste a free Gemini API key from Google AI Studio.
# Never expose this key in frontend variables or commit backend/.env.
GEMINI_API_KEY=your_gemini_api_key_here

ENGINE_LAB_ENVIRONMENT=development
ENGINE_LAB_DATABASE_URL=sqlite:///../ai_education.db
ENGINE_LAB_SECRET_KEY=replace-with-a-long-random-secret
ENGINE_LAB_ACCESS_TOKEN_EXPIRE_MINUTES=120
ENGINE_LAB_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ENGINE_LAB_ALLOW_TEACHER_SELF_REGISTRATION=false
ENGINE_LAB_AI_PROVIDER=gemini
ENGINE_LAB_AI_MODEL=gemini-2.5-flash
ENGINE_LAB_AI_TIMEOUT_SECONDS=30
ENGINE_LAB_AI_MAX_OUTPUT_TOKENS=800

# Optional Nova3D integration
ENGINE_LAB_NOVA3D_AUTH_TOKEN=
ENGINE_LAB_NOVA3D_PROVIDER_API_KEY=
